// Tar: glossy black with an oily rainbow sheen at grazing angles and a
// slow drip wobble. As `crack` rises (per tarback: focus time / 1.5 s),
// glowing orange fissures spread across the shell.
material {
  name: "tar",
  shading_model: lit,
  blending: opaque,
  culling: back,
  parameters: [
    { type: float, name: time, default: 0.0 },
    { type: float, name: crack, hint: range(0, 1, 0.01), default: 0.0 },
    { type: vec3, name: tar_color, default: [0.015, 0.014, 0.018] },
    { type: vec3, name: fissure_color, default: [2.2, 0.8, 0.15] },
  ],
}
vertex {
  #include <noise.glsl>

  void Vertex(inout VertexInputs vertex) {
    float drip = NoiseSimplex3(vertex.position * 7.0 +
        vec3(0.0, material_params.time * 0.35, 0.0), 61);
    vertex.world_position += vertex.world_normal * drip * 0.008;
  }
}
fragment {
  #include <noise.glsl>
  precision highp float;

  void Surface(inout MaterialInputs material) {
    vec3 wp = GetWorldPosition();
    vec3 n = normalize(GetWorldNormal());
    vec3 v = normalize(GetViewDirection());
    float graze = pow(1.0 - clamp(dot(n, v), 0.0, 1.0), 3.0);
    // Oily sheen: hue shifts with the grazing angle.
    float hue = graze * 6.2831 + wp.y * 3.0;
    vec3 sheen = 0.5 + 0.5 * cos(hue + vec3(0.0, 2.1, 4.2));
    vec3 base = material_params.tar_color + sheen * graze * 0.18;

    // Fissures: ridged noise lines that widen and spread with `crack`.
    float c = clamp(material_params.crack, 0.0, 1.0);
    float ridge = 1.0 - abs(NoiseSimplex3(wp * 5.0, 71));
    float spread = NoiseSimplex3(wp * 1.7, 73) * 0.5 + 0.5;
    float reach = smoothstep(1.0 - c * 1.1, 1.0 - c * 1.1 + 0.2, spread);
    float fissure = smoothstep(0.93 - c * 0.08, 0.99, ridge) * reach * step(0.01, c);
    float pulse = 0.8 + 0.2 * sin(material_params.time * 9.0);

    material.base_color = vec4(base, 1.0);
    material.emissive = material_params.fissure_color * fissure * pulse;
    material.roughness = 0.12;
    material.metallic = 0.0;
  }
}
