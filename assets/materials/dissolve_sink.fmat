// A crab corpse burning away: a noise dissolve with a hot ember rim as it
// goes (progress 0..1, per corpse). Crabs only, never the keeper.
material {
  name: "dissolve_sink",
  shading_model: unlit,
  blending: opaque,
  culling: none,
  parameters: [
    { type: float, name: progress, hint: range(0, 1, 0.01), default: 0.0 },
    { type: vec3, name: char_color, default: [0.06, 0.04, 0.04] },
    { type: vec3, name: ember_color, default: [1.8, 0.6, 0.12] },
    { type: float, name: noise_scale, hint: range(0.5, 12, 0.1), default: 6.0 },
  ],
}
fragment {
  #include <noise.glsl>
  precision highp float;

  void Surface(inout MaterialInputs material) {
    float n = NoiseSimplex3(GetWorldPosition() * material_params.noise_scale, 31) * 0.5 + 0.5;
    float threshold = material_params.progress * 1.15;
    if (n < threshold) {
      discard;
    }
    float edge = 1.0 - smoothstep(threshold, threshold + 0.12, n);
    vec3 color = mix(material_params.char_color, material_params.ember_color, edge);
    material.base_color = vec4(color, 1.0);
  }
}
