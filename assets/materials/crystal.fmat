// Crystal: a glassback's shell and the prism's crystal. Cyan edge glow at
// grazing angles and a faceted inner shimmer; it flares while reflecting
// the beam (charge).
material {
  name: "crystal",
  shading_model: unlit,
  blending: opaque,
  culling: back,
  parameters: [
    { type: float, name: time, default: 0.0 },
    { type: float, name: charge, hint: range(0, 1, 0.01), default: 0.0 },
    { type: vec3, name: body_color, default: [0.05, 0.20, 0.26] },
    { type: vec3, name: rim_color, default: [0.45, 1.6, 1.8] },
    { type: vec3, name: flare_color, default: [1.6, 1.4, 0.9] },
  ],
}
fragment {
  #include <noise.glsl>

  void Surface(inout MaterialInputs material) {
    vec3 n = normalize(GetWorldNormal());
    vec3 v = normalize(GetViewDirection());
    float rim = pow(1.0 - clamp(abs(dot(n, v)), 0.0, 1.0), 2.5);
    vec3 wp = GetWorldPosition();
    float facets = floor((NoiseSimplex3(wp * 4.0 + vec3(material_params.time * 0.3), 37) * 0.5 + 0.5) * 4.0) / 4.0;
    vec3 color = material_params.body_color * (0.6 + 0.8 * facets) +
        material_params.rim_color * rim;
    color += material_params.flare_color * material_params.charge * (0.4 + rim);
    material.base_color = vec4(color, 1.0);
  }
}
