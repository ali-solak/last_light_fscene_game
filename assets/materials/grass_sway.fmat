// Grass tufts swaying in the wind, each blade on its own phase.
material {
  name: "grass_sway",
  shading_model: lit,
  blending: opaque,
  culling: none,
  parameters: [
    { type: float, name: time, default: 0.0 },
    { type: float, name: wind_strength, hint: range(0, 2, 0.01), default: 0.35 },
    { type: vec2, name: wind_dir, default: [0.8, 0.6] },
    { type: float, name: sway_scale, hint: range(0.01, 2, 0.01), default: 0.4 },
    { type: sampler2d, name: palette, hint: default_white },
  ],
  varyings: [
    { type: float, name: blade_h },
  ],
}
vertex {
  #include <noise.glsl>

  void Vertex(inout VertexInputs vertex) {
    float h = clamp(vertex.position.y / 0.49, 0.0, 1.0);
    blade_h = h;
    vec2 phase = vertex.world_position.xz * material_params.sway_scale +
        material_params.wind_dir * material_params.time * 0.9;
    float gust = NoiseSimplex2(phase, 7);
    float flutter =
        NoiseSimplex2(phase * 3.1 + vec2(0.0, material_params.time * 2.3), 13) * 0.3;
    vertex.world_position.xz += material_params.wind_dir * (gust + flutter) *
        material_params.wind_strength * h * h * 0.4;
  }
}
fragment {
  void Surface(inout MaterialInputs material) {
    vec3 base = SRGBToLinear(texture(palette, GetUV0()).rgb);
    material.base_color = vec4(base * mix(0.6, 1.1, blade_h), 1.0);
    material.roughness = 1.0;
    material.metallic = 0.0;
  }
}
