// The sky over the island. Night: a deep blue gradient with a cold haze on
// the sea horizon, two layers of twinkling stars, a faint milky way, and a
// big low moon (maria, a tight halo and a wide glow) sitting exactly where
// the moonlight comes from. A cloud deck drifts on the wind; on storm
// nights it thickens, swallows the stars and flashes with lightning.
// `dawn` runs 0 (night) to 1 (sunrise) and warms everything.
material {
  name: "sky",
  parameters: [
    { type: float, name: time, default: 0.0 },
    { type: float, name: dawn, hint: range(0, 1, 0.01), default: 0.0 },
    { type: vec3, name: moon_dir, default: [0.5, 0.3, -0.8] },
    { type: float, name: moon_intensity, hint: range(0, 8, 0.05), default: 0.5 },
    { type: float, name: star_brightness, hint: range(0, 3, 0.01), default: 1.0 },
    { type: float, name: cloud_cover, hint: range(0, 1, 0.01), default: 0.35 },
    { type: float, name: storm, hint: range(0, 1, 0.01), default: 0.0 },
    { type: float, name: lightning, hint: range(0, 1, 0.01), default: 0.0 },
    { type: vec2, name: wind, default: [0.9, 0.3] },
    { type: vec3, name: night_zenith, default: [0.003, 0.006, 0.018] },
    { type: vec3, name: night_horizon, default: [0.020, 0.032, 0.065] },
    { type: vec3, name: dawn_zenith, default: [0.20, 0.32, 0.55] },
    { type: vec3, name: dawn_horizon, default: [1.10, 0.62, 0.36] },
  ],
}
sky {
  float Hash1(vec3 p) {
    p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
  }

  float ValueNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(mix(Hash1(i), Hash1(i + vec3(1.0, 0.0, 0.0)), f.x),
            mix(Hash1(i + vec3(0.0, 1.0, 0.0)), Hash1(i + vec3(1.0, 1.0, 0.0)), f.x),
            f.y),
        mix(mix(Hash1(i + vec3(0.0, 0.0, 1.0)), Hash1(i + vec3(1.0, 0.0, 1.0)), f.x),
            mix(Hash1(i + vec3(0.0, 1.0, 1.0)), Hash1(i + vec3(1.0, 1.0, 1.0)), f.x),
            f.y),
        f.z);
  }

  float Fbm(vec3 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 5; i++) {
      v += a * ValueNoise(p);
      p = p * 2.03 + 11.5;
      a *= 0.5;
    }
    return v;
  }

  // A hash-grid star layer: per-star size, brightness, tint and twinkle.
  vec3 Stars(vec3 d, float scale, float density) {
    vec3 p = d * scale;
    vec3 id = floor(p);
    vec3 h = vec3(Hash1(id), Hash1(id + 19.19), Hash1(id + 42.42));
    if (h.x > density) {
      return vec3(0.0);
    }
    vec3 star = id + 0.5 + (h - 0.5) * 0.6;
    float dist = length(p - star);
    float bright = pow(h.z, 10.0);
    float radius = 0.03 + 0.03 * bright;
    float shape = exp(-dist * dist / (radius * radius));
    float twinkle = 0.75 + 0.3 * sin(material_params.time * (1.5 + 3.5 * h.y) + h.z * 40.0);
    vec3 tint = mix(vec3(1.0, 0.84, 0.66), vec3(0.74, 0.84, 1.0), Hash1(id + 7.7));
    return tint * shape * (0.4 + 5.0 * bright) * twinkle;
  }

  vec3 Sky(vec3 direction) {
    vec3 d = normalize(direction);
    float up = d.y;
    float night = 1.0 - material_params.dawn;
    float storm = material_params.storm;

    // Base gradient, varied at large scale so the zenith never bands.
    float h = pow(1.0 - clamp(up, 0.0, 1.0), 3.0);
    vec3 nightColor = mix(material_params.night_zenith, material_params.night_horizon, h);
    nightColor *= 0.85 + 0.3 * Fbm(d * 1.3 + 5.0);
    vec3 dawnColor = mix(material_params.dawn_zenith, material_params.dawn_horizon, h);
    vec3 color = mix(nightColor, dawnColor, material_params.dawn);

    // The sea below the horizon: dark, catching a little of the haze.
    if (up < 0.0) {
      vec3 sea = material_params.night_horizon * 0.35 + dawnColor * 0.25 * material_params.dawn;
      return mix(color, sea, smoothstep(0.0, -0.06, up));
    }

    // Haze hugging the horizon, cold out to sea.
    float band = exp(-up * 14.0);
    color += vec3(0.012, 0.018, 0.03) * band * night;

    float extinction = smoothstep(0.0, 0.15, up);

    // The milky way, a tilted band carved by dust lanes.
    vec3 bandNormal = normalize(vec3(0.35, 0.28, 0.9));
    float w = dot(d, bandNormal);
    float milky = exp(-w * w * 34.0);
    if (milky > 0.004) {
      float clouds = Fbm(d * 5.0);
      float lanes = Fbm(d * 11.0 + 31.7);
      float mw = milky * pow(clouds, 1.6) * (0.3 + 0.7 * smoothstep(0.25, 0.75, lanes));
      color += vec3(0.045, 0.05, 0.065) * mw * extinction * night;
    }

    vec3 stars = Stars(d, 26.0, 0.10) + Stars(d, 64.0, 0.28) * (0.3 + 0.5 * milky);
    vec3 heavens = stars * material_params.star_brightness * extinction;

    // The moon: a big HDR disc with maria, a tight halo and a broad glow.
    vec3 moonDir = normalize(material_params.moon_dir);
    float m = dot(d, moonDir);
    float disc = smoothstep(0.99880, 0.99915, m);
    if (disc > 0.0) {
      // Shade the disc toward its limb so it reads as a sphere.
      float limb = smoothstep(0.99880, 0.99990, m);
      float maria = 0.62 + 0.45 * Fbm(d * 70.0 + 3.0);
      heavens += vec3(0.95, 0.97, 1.05) * material_params.moon_intensity * disc *
          maria * (0.75 + 0.25 * limb);
    }
    heavens += vec3(0.32, 0.4, 0.55) * pow(max(m, 0.0), 2000.0) * 0.06;
    color += vec3(0.02, 0.03, 0.05) * pow(max(m, 0.0), 60.0) * night;
    color += heavens * night;

    // The cloud deck: projected onto a plane overhead, drifting on the
    // wind, thicker in a storm. Moonlit edges near the moon.
    vec2 cp = d.xz / (up + 0.12);
    vec2 drift = material_params.wind * material_params.time * (0.008 + 0.02 * storm);
    float cover = Fbm(vec3((cp + drift) * 0.5, material_params.time * 0.005));
    float threshold = 0.64 - 0.3 * material_params.cloud_cover - 0.25 * storm;
    float clouds = smoothstep(threshold, threshold + 0.24, cover) * smoothstep(0.01, 0.1, up);
    float moonlit = pow(max(m, 0.0), 8.0);
    vec3 cloudColor = vec3(0.008, 0.01, 0.016) + vec3(0.05, 0.06, 0.08) * moonlit * (1.0 - storm);
    cloudColor = mix(cloudColor, dawnColor * 0.7, material_params.dawn);
    // Lightning lights the cloud deck from inside.
    float flash = material_params.lightning * (0.6 + 0.4 * Fbm(vec3(cp * 0.8, material_params.time * 3.0)));
    cloudColor += vec3(0.55, 0.6, 0.8) * flash;
    color = mix(color, cloudColor, clamp(clouds * (0.85 + 0.15 * storm), 0.0, 0.97));
    color += vec3(0.08, 0.09, 0.13) * material_params.lightning * (1.0 - clouds) * 0.5;
    return color;
  }
}
